# Supabase (Project Settings → API). Leave both empty to run in DEMO MODE.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mode: demo mode override (true/false)
VITE_DEMO_MODE=false

# Backend mode: "browser" (runs in tab, persists to Supabase) or "fastapi"
VITE_BACKEND_MODE=browser

# FastAPI backend (only used when VITE_BACKEND_MODE=fastapi)
VITE_API_URL=http://localhost:8000

# Demo account for the Try the demo button. Keep empty to hide the button when live.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
